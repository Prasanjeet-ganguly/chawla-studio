# Chawla Studio — environment configuration
#
# Copy to .env.local and fill in the real studio details.
# Every value is optional: anything left blank renders as a clearly-marked
# placeholder in the UI instead of a fabricated number or handle.

# Absolute site URL. Used for canonical tags, sitemap.xml and Open Graph.
# NEXT_PUBLIC_* values are compiled into the pages, so this has to be set before
# `npm run build` / `npm run export` — changing it later means building again.
NEXT_PUBLIC_SITE_URL=

# Digits only, including country code, no +, spaces or dashes.
# Example for India: 919812345678
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Shown in the contact section and footer.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=

# Free text, e.g. "New Delhi, India"
NEXT_PUBLIC_STUDIO_LOCATION=

# Full profile URLs, plus the handle to display (without the @).
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_INSTAGRAM_HANDLE=
NEXT_PUBLIC_YOUTUBE_URL=

# Optional POST endpoint for the enquiry form (Formspree, Basin, your own API).
# Leave blank and the form composes a pre-filled email instead.
NEXT_PUBLIC_ENQUIRY_ENDPOINT=

# Embed URL for the studio showreel (YouTube/Vimeo *embed* address, e.g.
# https://www.youtube.com/embed/XXXXXXXXXXX). Leave blank and the hero's
# "watch showreel" button opens a dialog that says the film is not published
# yet — it never pretends to play one.
NEXT_PUBLIC_SHOWREEL_URL=

# ---------------------------------------------------------------------------
# Studio figures. THE DEFAULTS ARE SAMPLE NUMBERS, NOT CHAWLA STUDIO'S RECORD.
#
# Used by the hero's statistics panel, the wedding crest and the cinematic
# loading screen — each number is read once here and shared, so the three can
# never disagree.
#
# Until NEXT_PUBLIC_FIGURES_CONFIRMED is set to true, the hero prints a quiet
# "sample figures" line under the statistics panel, the wedding badge carries a
# "sample" mark, and the loading screen says the same under its four figures.
# Put the studio's real counts here, then set the flag, and the marks disappear.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_STAT_YEARS=
NEXT_PUBLIC_STAT_CLIENTS=
NEXT_PUBLIC_STAT_PROJECTS=
NEXT_PUBLIC_STAT_WEDDINGS=
# Average review score, e.g. 4.8 — the loading screen sets the star itself.
NEXT_PUBLIC_STAT_RATING=
NEXT_PUBLIC_FIGURES_CONFIRMED=
